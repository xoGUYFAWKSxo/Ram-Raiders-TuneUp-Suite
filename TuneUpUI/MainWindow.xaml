                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CATEGORY 2: Windows Usage Tweaks -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <TextBlock Text="Windows Usage Tweaks" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Apply All in this Category" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="BtnApplyCategory_Click" Tag="WindowsUsage"/>
                                        </Grid>
                                        <Separator Background="#33FFFFFF" Margin="0,0,0,15"/>
                                        
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable '- Shortcut' suffix for new shortcuts" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableShortcutSuffix" Tag="DisableShortcutSuffix" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
