                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Windows Resources" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Shortcuts to the management tools built into Windows." Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <!-- Content Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="Disk Management" Tag="diskmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Computer Management" Tag="compmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="1" Grid.Column="0" Content="Task Manager" Tag="taskmgr" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Programs and Features" Tag="appwiz.cpl" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="2" Grid.Column="0" Content="Device Manager" Tag="devmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Event Viewer" Tag="eventvwr.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="3" Grid.Column="0" Content="System Properties" Tag="sysdm.cpl" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="Control Panel" Tag="control" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>

                            <Button Grid.Row="4" Grid.Column="0" Content="Registry Editor" Tag="regedit.exe" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="Group Policy Editor" Tag="gpedit.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 8: STORAGE TOOLS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Storage Tools" Foreground="White" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Move a game folder to another drive. A link is left at the old path, so launchers and games still find the files there." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Migrator Card -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Game Folder Mover" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Pick a game folder and a destination on another drive. The engine copies the files, checks that every file arrived at the same size, deletes the original folder, then puts a symbolic link at the original path. Undo moves the folder back." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                        <!-- Source Path -->
                                        <TextBlock Text="Source Directory" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#12122A" BorderBrush="#333350" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtMigSource" Foreground="White" FontSize="13" Text="No directory selected..."/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource OutlineButton}" Padding="14,8" Click="BtnMigBrowseSource_Click"/>
                                        </Grid>

                                        <!-- Destination Path -->
                                        <TextBlock Text="Destination Directory (on target drive)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#12122A" BorderBrush="#333350" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtMigDest" Foreground="White" FontSize="13" Text="No destination selected..."/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource OutlineButton}" Padding="14,8" Click="BtnMigBrowseDest_Click"/>
                                        </Grid>

                                        <!-- Analysis Row -->
                                        <TextBlock x:Name="TxtMigAnalysis" Foreground="#3B82F6" FontSize="13" Margin="0,0,0,12" Visibility="Collapsed"/>

                                        <!-- Progress -->
                                        <ProgressBar x:Name="ProgMigrate" Height="6" Margin="0,0,0,8"
                                                     Foreground="#6366F1" Background="#1E1E3A" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMigProgress" Foreground="{StaticResource BrushTextMuted}" FontSize="12" 
                                                   Margin="0,0,0,12" Visibility="Collapsed"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnMigAnalyze" Content="&#xE8B0; Analyze" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource OutlineButton}"
                                                    Padding="14,8" Margin="0,0,10,0" IsEnabled="False" Click="BtnMigAnalyze_Click"/>
                                            <Button x:Name="BtnMigrate" Content="&#xE8DE; Migrate &amp; Symlink" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource PremiumButton}"
                                                    Padding="14,8" IsEnabled="False" Click="BtnMigrate_Click"/>
                                            <Button x:Name="BtnCancelMigration" Content="Cancel" Style="{StaticResource OutlineButton}"
                                                    Padding="14,8" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnCancelMigration_Click"
                                                    ToolTip="Stops while files are still being copied; the original folder is left untouched"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- History Card -->
                                <Border Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Previous Migrations" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <Button Grid.Column="1" Content="&#xE72C; Refresh" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource OutlineButton}"
                                                    Padding="10,4" FontSize="12" Click="BtnMigRefreshHistory_Click"/>
                                        </Grid>

                                        <ItemsControl x:Name="IcMigrationHistory">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0D0D1F" CornerRadius="6" Padding="12,10" Margin="0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding OriginalPath}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11">
                                                                    <Run Text="&#x2192; "/>
                                                                    <Run Text="{Binding DestinationPath}"/>
                                                                    <Run Text="  &#x2022;  "/>
                                                                    <Run Text="{Binding SizeBytes, Converter={x:Static local:BytesConverter.Instance}}"/>
                                                                    <Run Text="  &#x2022;  "/>
                                                                    <Run Text="{Binding MigratedAt, StringFormat='{}{0:MMM dd, yyyy}'}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                                    Background="{Binding SymlinkActive, Converter={x:Static local:BoolToBadgeConverter.Instance}}">
                                                                <TextBlock Foreground="White" FontSize="10" FontWeight="Bold"
                                                                           Text="{Binding SymlinkActive, Converter={x:Static local:BoolToSymlinkLabelConverter.Instance}}"/>
                                                            </Border>
                                                            <Button Grid.Column="2" Content="Undo" Style="{StaticResource OutlineButton}" Padding="10,3" FontSize="11"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center" Tag="{Binding OriginalPath}"
                                                                    ToolTip="Move the folder back to its original location and remove the link"
                                                                    Click="BtnUndoMigration_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="TxtNoHistory" Text="No migrations recorded yet." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="13" 
                                                   HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>






