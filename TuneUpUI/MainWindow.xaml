<Window x:Class="TuneUpUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TuneUpUI"
        mc:Ignorable="d"
        Title="Galactic Tune-Up" 
        Icon="/TuneUpIcon.ico"
        Height="680" Width="1040"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="#252535"
        BorderThickness="1"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <!-- Custom frame: edges and corners resize the window, the title bar drags it (double-click
         maximizes, Aero Snap works). Buttons in the title bar opt back in to clicks. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="40"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="220"/>
            <!-- Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TITLE BAR (Spans both columns) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BrushBgDark}" 
                BorderBrush="#252535" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrushNeonAccent}" Margin="0,0,10,0"/>
                    <TextBlock Text="GALACTIC TUNE-UP" Foreground="{StaticResource BrushTextMain}" 
                               FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushTextMuted}" 
                            Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" 
                            Click="SettingsButton_Click" ToolTip="Settings" Margin="0,0,5,0"/>
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushTextMuted}" 
                            Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" 
                            Click="MinButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushTextMuted}" 
                            Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" 
                            Click="MaxButton_Click" ToolTip="Maximize"/>
                    <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" 
                            Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" 
                            Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BrushBgDark}" 
                BorderBrush="#252535" BorderThickness="0,0,1,0" Padding="15,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="5,0,0,25">
                    <TextBlock Text="SYSTEM HEALTH" Foreground="{StaticResource BrushTextMuted}" 
                               FontSize="10" FontWeight="Bold"/>
                </StackPanel>

                <!-- Sidebar RadioButtons as Nav Items -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarButton}" IsChecked="True" Checked="NavButton_Checked" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton x:Name="NavCleaner" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="System Cleaner"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavRegistry" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Registry Guard"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavRepair" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Component Repair"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMonitor" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Live Monitor"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHardware" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Gaming/OS Tweaks"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 7. OS TOOLS -->
                    <RadioButton x:Name="NavOsTools" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Windows Resources"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 8. STORAGE TOOLS -->
                    <RadioButton x:Name="NavStorage" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked" Tag="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Storage Tools"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Connection Status Footer -->
                <Border Grid.Row="2" Background="#14141E" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatus" Text="Engine Offline" Foreground="{StaticResource BrushTextMain}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Background service" Foreground="{StaticResource BrushTextMuted}" FontSize="9"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="25">
            <TabControl x:Name="ContentTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/> <!-- Hide Tab Headers -->
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- TAB 0: DASHBOARD -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dynamic Health Stats Banner -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Physical Memory -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="AVAILABLE MEMORY" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtFreeRamPercent" Text="-- %" Foreground="{StaticResource BrushAccentCyan}" FontSize="28" FontWeight="Bold" Margin="0,5"/>
                                    <TextBlock x:Name="TxtFreeRamBytes" Text="-- GB / -- GB" Foreground="{StaticResource BrushTextMain}" FontSize="12"/>
                                </StackPanel>

                                <!-- Metric 2: Standby List Size -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="STANDBY LIST SIZE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtStandbyListSize" Text="-- MB" Foreground="{StaticResource BrushAccentPurple}" FontSize="28" FontWeight="Bold" Margin="0,5"/>
                                    <TextBlock Text="Cached files Windows can drop" Foreground="{StaticResource BrushTextMain}" FontSize="12"/>
                                </StackPanel>

                                <!-- Metric 3: Saved Total -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="TOTAL MEMORY RECLAIMED" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotalSaved" Text="0 MB" Foreground="{StaticResource BrushAccentGreen}" FontSize="28" FontWeight="Bold" Margin="0,5"/>
                                    <TextBlock Text="Freed this session" Foreground="{StaticResource BrushTextMain}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Core Toggles & Actions (Scrollable for future expansions) -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,15,0">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- Standby purge card -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Standby Page Cleaner" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="Turns the standby list (recently used files Windows keeps cached in RAM) back into free memory. Running programs keep their memory. Windows refills the cache over time, so this mainly helps games that stutter when free memory runs out." 
                                                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,15"/>
                                            <StackPanel>
                                                <Button Content="Purge Standby Memory" Style="{StaticResource PremiumButton}" Width="200" Click="BtnPurgeMemory_Click" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                                                <CheckBox x:Name="ToggleAutoPurge" Style="{StaticResource PremiumToggle}" Checked="ToggleAutoPurge_Checked" Unchecked="ToggleAutoPurge_Unchecked">
                                                    <StackPanel Margin="5,0,0,0">
                                                        <TextBlock Text="Auto-Purge (free memory &lt; 10%)" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="Empties the standby list when truly free memory drops below 10% of RAM while the cache holds at least as much, at most once a minute." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ProBalance CPU card -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="ProBalance (background CPU priority)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="When a program you aren't using keeps one CPU core more than 95% busy for 2 seconds, its priority is lowered to Below Normal, so the program in front gets the CPU first. On CPUs with efficiency cores it is also moved to those cores. Its priority goes back once its load drops." 
                                                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,15"/>
                                            <CheckBox x:Name="ToggleProBalance" Style="{StaticResource PremiumToggle}" Content="Enable ProBalance Monitoring" 
                                                      Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" Checked="ToggleProBalance_Checked" Unchecked="ToggleProBalance_Unchecked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Game Mode card -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <TextBlock Text="Game Mode" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="When a game is the window in front (recognised by its program name, or because it is in a game library folder such as Steam's), its priority is raised to High and the Ultimate Performance power plan is switched on until you leave it. On CPUs with at least 3 performance cores and some efficiency cores, the game is kept on the performance cores. Turning Game Mode on also changes a few Windows timer and scheduling settings for games; turning it off restores your previous values." 
                                                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,15"/>
                                            <CheckBox x:Name="ToggleGameMode" Style="{StaticResource PremiumToggle}" Content="Enable Game Mode" 
                                                      Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" Checked="ToggleGameMode_Checked" Unchecked="ToggleGameMode_Unchecked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Column 2: Quick Logs -->
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="ENGINE ACTIVITY LOG" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox Grid.Row="1" x:Name="LstDashboardEvents" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource BrushTextMain}" FontSize="11">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 1: SYSTEM CLEANER -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="System Cleaner" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Finds temporary files, caches and logs that Windows and your programs rebuild on their own, plus program caches from the community winapp2 list. You see each item and its size, and choose what to delete. Deleted files don't go to the Recycle Bin." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <!-- Scan type toggles -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ChkTempFiles" Style="{StaticResource PremiumToggle}" IsChecked="True" Content="Scan Temp Files" Margin="0,0,20,0" ToolTip="Your Temp folder, Windows error reports, the DirectX shader cache and Prefetch data."/>
                                <CheckBox x:Name="ChkWinUpdate" Style="{StaticResource PremiumToggle}" IsChecked="True" Content="Scan Windows Update Cache" Margin="0,0,20,0" ToolTip="The Delivery Optimization cache: update files Windows has already downloaded and keeps to share with other PCs."/>
                                <CheckBox x:Name="ChkBrowserCache" Style="{StaticResource PremiumToggle}" IsChecked="True" Content="Scan Browser Cache" Margin="0,0,20,0" ToolTip="Cache files from Chrome and Edge, plus the winapp2 list's entries for Chrome, Edge, Firefox and other browsers."/>
                                <CheckBox x:Name="ChkEmptyFolders" Style="{StaticResource PremiumToggle}" Content="Scan Empty User Folders" Margin="0,0,20,0" ToolTip="Empty folders in your Documents, Pictures, Videos, Music, Desktop, Downloads and OneDrive folders."/>
                                <CheckBox x:Name="ChkDuplicateFiles" Style="{StaticResource PremiumToggle}" Content="Scan Duplicate User Files" ToolTip="Files with identical content in those same folders. One copy of each set is always kept."/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Rules Grid -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
                            <ListView x:Name="LvwJunkItems" Background="Transparent" BorderThickness="0" 
                                      Foreground="White" SelectionChanged="LvwJunkItems_SelectionChanged"
                                      GridViewColumnHeader.Click="LvwJunkItems_ColumnHeaderClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Select" Width="60">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                     <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Category" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Category}" Foreground="White"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Cleaner Target" Width="250">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RuleName}" Foreground="White" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource BrushAccentCyan}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Files Found" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FilePaths.Count}" Foreground="White"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- File Detail Panel (shown on row selection) -->
                        <Border x:Name="PnlFileDetail" Grid.Row="2" 
                                Background="#12121E" BorderBrush="#252535" BorderThickness="1"
                                CornerRadius="8" Margin="0,8,0,0" Padding="12,10"
                                Visibility="Collapsed" MaxHeight="160">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Panel Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" 
                                                   Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDetailHeader" Text="Select a row to inspect its files" 
                                                   Foreground="{StaticResource BrushAccentCyan}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Click a path to open its location in Explorer" 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Scrollable file path list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="IcFilePaths">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2" Padding="8,5" Background="#1A1A2E" CornerRadius="4"
                                                        Cursor="Hand" MouseLeftButtonUp="FilePathItem_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" 
                                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" 
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" 
                                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" 
                                                                   Foreground="{StaticResource BrushAccentCyan}" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Footer Actions -->
                        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,0">
                            <!-- Two lines: status + progress get the full width, buttons sit below.
                                 (On one line, the status text was squeezed to a few pixels wide while
                                 scanning, wrapped one character per line and stretched the buttons.) -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtCleanerStatus" Text="Ready to scan file structures" Foreground="{StaticResource BrushTextMain}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ProgressBar Grid.Column="1" x:Name="ProgCleaner" Style="{StaticResource PremiumProgressBar}" Width="200" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- WrapPanel: on a narrow window the buttons move to a second line instead of being cut off. -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="BtnToggleSelectJunk" Content="&#x2713; Select All" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="15,5" Click="BtnToggleSelectJunk_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnCancelCleaner" Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="15,5" Visibility="Collapsed" Click="BtnCancelCleaner_Click"/>
                                    <Button Content="Scan for Junk Files" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" MinWidth="160" Click="BtnScanJunk_Click"/>
                                    <Button x:Name="BtnCleanJunk" Content="Empty Junk Files" Style="{StaticResource PremiumButton}" Margin="0,0,0,6" MinWidth="160" IsEnabled="False" Click="BtnCleanJunk_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>


                <!-- TAB 2: REGISTRY GUARD -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Registry Guard" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Finds registry entries that point to programs or files that no longer exist: startup entries, File Explorer shell extensions, and COM components registered for your account. Each entry you remove is saved to a .reg backup file first." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Issues List -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
                            <Grid>
                                <ListView x:Name="LvwRegistryIssues" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Select" Width="60">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Issue Title" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" Foreground="White" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Registry Location" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding KeyPath}" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Target Path (Missing)" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TargetPath}" Foreground="#EF4444" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Margin="0,15,0,0">
                            <!-- Same two-line layout as the cleaner, so long status text is never cut off. -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtRegistryStatus" Text="No scan performed yet" Foreground="{StaticResource BrushTextMain}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ProgressBar Grid.Column="1" x:Name="ProgRegistry" Style="{StaticResource PremiumProgressBar}" Width="200" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Buttons size to their text (fixed widths cut off "Repair Defective Entries")
                                     and wrap to a second line on a narrow window. -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="BtnToggleSelectRegistry" Content="&#x2713; Select All" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="15,5" Click="BtnToggleSelectRegistry_Click" IsEnabled="False"/>
                                    <Button Content="Scan Registry Integrity" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" MinWidth="180" Click="BtnScanRegistry_Click"/>
                                    <Button x:Name="BtnRepairRegistry" Content="Repair Defective Entries" Style="{StaticResource PremiumButton}" Margin="0,0,0,6" MinWidth="180" IsEnabled="False" Click="BtnRepairRegistry_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: COMPONENT REPAIR -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Windows File Repair" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Checks whether any of Windows' own files are damaged, using the results of Windows' built-in repair tools. If something is wrong, Repair Windows Files runs those tools (DISM and SFC) to restore good copies from Microsoft. It can take 10 to 20 minutes."
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Logs list -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="What Windows found" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox Grid.Row="1" x:Name="LstCbsCorruptions" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource BrushTextMain}" FontSize="11">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtComponentStatus" Text="Click Check for Problems to see the latest results." Foreground="{StaticResource BrushTextMain}" FontSize="12" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="ProgComponent" Style="{StaticResource PremiumProgressBar}" Width="200" Margin="20,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Check for Problems" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" MinWidth="180" Click="BtnScanComponent_Click"/>
                                    <Button x:Name="BtnRepairComponent" Content="Repair Windows Files" Style="{StaticResource PremiumButton}" MinWidth="180" Click="BtnRepairComponent_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: LIVE MONITOR -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="RowLatencyCard" Height="Auto"/>
                            <RowDefinition x:Name="RowMonitorEvents" Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Live Monitor" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="What the engine does as it happens: ProBalance priority changes, Game Mode, and standby memory purges. The driver audit below times how long drivers hold the CPU." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- DPC Latency Watchdog -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Driver DPC &amp; Interrupt Load" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtLatencyStatus" Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Text="Checks whether drivers are hogging your CPU cores, a common cause of game stutter and audio crackles. Start the audit, then use the PC normally (or play the game that stutters) for a few minutes."/>
                                        <Button x:Name="BtnLatencyHelp" Content="&#xE946; What is this, and how do I fix it?" FontFamily="Segoe UI, Segoe MDL2 Assets"
                                                Style="{StaticResource OutlineButton}" Padding="10,3" FontSize="11" Margin="0,8,0,0"
                                                HorizontalAlignment="Left" Click="BtnLatencyHelp_Click"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnStartLatency" Content="&#xE768; Start Audit" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource PremiumButton}"
                                                Padding="12,5" FontSize="12" Margin="0,0,8,0" Click="BtnStartLatency_Click"/>
                                        <Button x:Name="BtnStopLatency" Content="&#xE71A; Stop" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource OutlineButton}"
                                                Padding="12,5" FontSize="12" Margin="0,0,8,0" IsEnabled="False" Click="BtnStopLatency_Click"/>
                                        <Button x:Name="BtnSaveLatency" Content="&#xE74E; Save Trace" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource OutlineButton}"
                                                Padding="12,5" FontSize="12" IsEnabled="False" Click="BtnSaveLatency_Click"
                                                ToolTip="Save these results to a text or CSV file, to keep, share, or compare after a driver update"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Driver table header -->
                                <Grid Grid.Row="1" x:Name="GrdLatencyCoreHeader" Margin="0,0,25,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU core" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Peak load %" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                               ToolTip="Highest share of this core's time spent on driver work, averaged over 5 seconds"/>
                                    <TextBlock Grid.Column="2" Text="DPC %" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                               ToolTip="Deferred driver work (the bulk of most drivers' processing) during that peak"/>
                                    <TextBlock Grid.Column="3" Text="ISR %" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                               ToolTip="Interrupt handling (the first, urgent step when a device signals the CPU) during that peak"/>
                                    <TextBlock Grid.Column="4" Text="Status" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                </Grid>
                                <Separator Grid.Row="2" x:Name="SepLatencyCores" Background="#333350" Margin="0,0,0,6"/>

                                <ScrollViewer Grid.Row="3" x:Name="SvLatencyCores" MaxHeight="160" VerticalScrollBarVisibility="Visible">
                                    <ItemsControl x:Name="IcLatencyDrivers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,8,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="78"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PeakTotalPercent, StringFormat='{}{0:F1}'}"
                                                               Foreground="{Binding IsSpike, Converter={x:Static local:BoolToColorConverter.Instance}}"
                                                               FontSize="12" FontWeight="Bold" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PeakDpcPercent, StringFormat='{}{0:F1}'}"
                                                               Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PeakInterruptPercent, StringFormat='{}{0:F1}'}"
                                                               Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextAlignment="Right"/>
                                                    <Border Grid.Column="4" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                                            Background="{Binding Status, Converter={x:Static local:LatencyStatusBadgeConverter.Instance}}">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Per-driver results from the kernel trace -->
                                <StackPanel Grid.Row="4" x:Name="PnlDriverSection" Margin="0,14,0,0">
                                    <TextBlock Text="Drivers, longest single run first" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDriverTraceStatus" Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Start the audit to time every driver's interrupt and deferred work."/>
                                    <Grid Margin="0,0,25,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="78"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Driver" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="What it is" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="Longest (µs)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                                   ToolTip="The longest this driver held a CPU core in one go, in microseconds (1,000 µs = 1 ms)"/>
                                        <TextBlock Grid.Column="3" Text="Runs" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                                   ToolTip="How many times the driver ran (deferred and interrupt work) since the audit started"/>
                                        <TextBlock Grid.Column="4" Text="Total ms" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right"
                                                   ToolTip="All of this driver's runs added together, in milliseconds"/>
                                        <TextBlock Grid.Column="5" Text="Status" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="#333350" Margin="0,0,0,6"/>
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Visible">
                                        <ItemsControl x:Name="IcLatencyDriverList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,8,2" Background="Transparent" ToolTip="{Binding Advice}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="78"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Driver}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding HighestMicroseconds, StringFormat='{}{0:N0}'}"
                                                                   Foreground="{Binding IsSpike, Converter={x:Static local:BoolToColorConverter.Instance}}"
                                                                   FontSize="12" FontWeight="Bold" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding RunCount, StringFormat='{}{0:N0}'}"
                                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding TotalMilliseconds, StringFormat='{}{0:N1}'}"
                                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextAlignment="Right"/>
                                                        <Border Grid.Column="5" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                                                Background="{Binding Status, Converter={x:Static local:LatencyStatusBadgeConverter.Instance}}">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="TxtDriverAdvice" Foreground="{StaticResource BrushTextMain}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- Plain-English explainer, toggled by BtnLatencyHelp -->
                                <!-- Fills the space left in the window and scrolls; see BtnLatencyHelp_Click -->
                                <Border Grid.Row="5" x:Name="PnlLatencyHelp" Visibility="Collapsed" Background="#15151F" CornerRadius="6"
                                        Margin="0,12,0,0" BorderBrush="#333350" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,6,12">
                                    <StackPanel Margin="0,0,8,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                            </Style>
                                        </StackPanel.Resources>

                                        <TextBlock Text="What this measures" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                        <TextBlock Text="When a device (network card, graphics card, USB, storage, audio) needs attention, its driver interrupts a CPU core. While that driver runs, nothing else can use that core, including your game or the sound playing through your speakers. Windows calls this interrupt (ISR) and deferred (DPC) work."/>
                                        <TextBlock Text="A few percent is normal. If one driver takes too long, the game misses a frame (stutter) or the audio buffer runs dry (crackles and pops). When one core reads much higher than the rest, that usually means one device's driver."/>

                                        <TextBlock Text="Reading the results" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,8,0,6"/>
                                        <TextBlock Text="CPU core table: the share of each core's time spent on driver work, over 5 seconds."/>
                                        <TextBlock Text="&#x2022;  OK (under 3%): drivers aren't the problem on this core."/>
                                        <TextBlock Text="&#x2022;  ELEVATED (3 to 10%): usually harmless. Only worth chasing if you actually hear crackles or see stutter."/>
                                        <TextBlock Text="&#x2022;  HIGH (10% or more): a driver is very likely causing stutter or audio problems."/>
                                        <TextBlock Text="Driver table: each driver's longest single run, timed one by one. It catches rare, very long delays that barely move the core numbers." Margin="0,8,0,6"/>
                                        <TextBlock Text="&#x2022;  OK under 500 µs, ELEVATED from 500 µs, HIGH from 2,000 µs (2 ms, long enough to empty an audio buffer and cause a crackle)."/>

                                        <TextBlock Text="How to fix high driver load" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,8,0,6"/>
                                        <TextBlock Text="1.  Find the driver. Leave the audit running while the problem happens. The driver at the top of the driver table is the one to fix; hover over it for advice."/>
                                        <TextBlock Text="2.  Update or roll back that driver. Get it from your PC, motherboard, or device maker rather than a driver-updater tool. If the problem started after an update, roll back in Device Manager (device, Properties, Driver, Roll Back Driver)."/>
                                        <TextBlock Text="3.  Common culprits. Wi-Fi and network (ndis.sys, tcpip.sys, adapter drivers): update, or test with a cable. Graphics (nvlddmkm.sys, amdkmdag.sys, dxgkrnl.sys): do a clean driver reinstall. Storage (storport.sys, stornvme.sys): update chipset drivers and SSD firmware. ACPI.sys: update the BIOS. Audio and USB: update, or try a different USB port."/>
                                        <TextBlock Text="4.  Update the BIOS and chipset drivers from your motherboard or laptop maker. Many driver timing problems are firmware bugs."/>
                                        <TextBlock Text="5.  Disable devices you don't use in Device Manager (spare network adapters, Bluetooth, unused onboard audio). A device that's off can't interrupt."/>
                                        <TextBlock Text="6.  Run the audit again to confirm the fix worked."/>

                                        <TextBlock Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0"
                                                   Text="Skip tweaks that promise lower latency, like disabling HPET, changing timer resolution, or forcing every device into MSI mode. On current Windows they rarely help and can make things worse. Fix the driver instead."/>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Event Grid -->
                        <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Engine log" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox Grid.Row="1" x:Name="LstMonitorEvents" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource BrushTextMain}" FontSize="12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1F1F2B" BorderThickness="0,0,0,1" Padding="0,5">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>


                <!-- TAB 5: SETTINGS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Application Preferences" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Choose how Galactic Tune-Up starts, what closing the window does, and when it notifies you." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Cards container (Scrollable for flexibility) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Card 1: Basic Settings -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Basic Settings" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                        
                                        <!-- Start on Startup -->
                                        <CheckBox x:Name="ChkStartOnStartup" Style="{StaticResource PremiumToggle}" Margin="0,0,0,15" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Start on Startup" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Automatically launch Galactic Tune-Up when Windows starts" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        
                                        <!-- Launch UI Minimized -->
                                        <CheckBox x:Name="ChkLaunchUiMinimized" Style="{StaticResource PremiumToggle}" Margin="0,0,0,15" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Launch UI Minimized" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Launch the user interface minimized to the system tray" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        
                                        <!-- Minimize to Tray on Close -->
                                        <CheckBox x:Name="ChkMinimizeToTrayOnClose" Style="{StaticResource PremiumToggle}" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Minimize to Tray on Close" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Hide the window instead of closing the application" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Card 2: Notification settings -->
                                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Notification Settings" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                        
                                        <!-- Enable Tray Notifications -->
                                        <CheckBox x:Name="ChkEnableNotifications" Style="{StaticResource PremiumToggle}" Margin="0,0,0,15" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Enable Tray Notifications" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="While the window is hidden, show a tray notification for the events below" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        
                                        <!-- ProBalance Toast -->
                                        <CheckBox x:Name="ChkProBalanceToast" Style="{StaticResource PremiumToggle}" Margin="0,0,0,15" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="ProBalance Toast Alerts" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Notify when a background process CPU priority is lowered" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        
                                        <!-- Memory Purge Toast -->
                                        <CheckBox x:Name="ChkMemoryPurgeToast" Style="{StaticResource PremiumToggle}" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Memory Purge Alerts" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Notify when standby memory pages are flushed" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                        
                        <!-- Footer status indicator -->
                        <Border Grid.Row="2" Margin="0,15,0,0" Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushAccentCyan}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings are automatically saved and applied" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

