                                            <CheckBox Grid.Column="1" x:Name="TglDisableStoreUpdates" Tag="DisableStoreUpdates" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable Telemetry and Data Collection" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableTelemetry" Tag="DisableTelemetry" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
