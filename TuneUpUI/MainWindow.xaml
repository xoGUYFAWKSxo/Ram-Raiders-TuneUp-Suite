                                    </StackPanel>
                                </Border>

                                <!-- CATEGORY 4: Desktop Tweaks -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <TextBlock Text="Desktop Tweaks" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Apply All in this Category" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="BtnApplyCategory_Click" Tag="DesktopTweaks"/>
                                        </Grid>
                                        <Separator Background="#33FFFFFF" Margin="0,0,0,15"/>
                                        
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Speed up mouse hover action" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglSpeedUpMouseHover" Tag="SpeedUpMouseHover" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Speed up desktop and folders loading (icon cache)" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglSpeedUpDesktopLoading" Tag="SpeedUpDesktopLoading" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable Bing in Taskbar search" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableBingSearch" Tag="DisableBingSearch" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Add 'End Task' context menu item in Taskbar" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglTaskbarEndTask" Tag="TaskbarEndTask" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Show seconds in Taskbar clock" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglTaskbarSeconds" Tag="TaskbarSeconds" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CATEGORY 5: File Explorer Tweaks -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <TextBlock Text="File Explorer Tweaks" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Apply All in this Category" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="BtnApplyCategory_Click" Tag="FileExplorer"/>
                                        </Grid>
                                        <Separator Background="#33FFFFFF" Margin="0,0,0,15"/>
                                        
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable 'You have new apps that can open this file'" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableNewAppPrompt" Tag="DisableNewAppPrompt" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Add Command Prompt As Administrator to Context Menu" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglCmdAdminContextMenu" Tag="CmdAdminContextMenu" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Enable Auto Completion in File Explorer" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglExplorerAutoComplete" Tag="ExplorerAutoComplete" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Show Drive Letters First" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglShowDriveLettersFirst" Tag="ShowDriveLettersFirst" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CATEGORY 6: Windows Appearance Tweaks -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <TextBlock Text="Windows Appearance Tweaks" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Apply All in this Category" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="BtnApplyCategory_Click" Tag="WindowsAppearance"/>
                                        </Grid>
                                        <Separator Background="#33FFFFFF" Margin="0,0,0,15"/>
                                        
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Speed up Aero Snap" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglSpeedUpAeroSnap" Tag="SpeedUpAeroSnap" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Boost display speed of Windows Peek" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglSpeedUpWindowsPeek" Tag="SpeedUpWindowsPeek" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Speed up Windows menus cascading delay" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglSpeedUpMenus" Tag="SpeedUpMenus" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Enable Windows 10-like context menu" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglWin10ContextMenu" Tag="Win10ContextMenu" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable Ads in Windows 11" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableWin11Ads" Tag="DisableWin11Ads" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable blur on the Sign-in Screen" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableSigninBlur" Tag="DisableSigninBlur" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Enable Battery Life Estimated Time" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglEnableBatteryEstimatedTime" Tag="EnableBatteryEstimatedTime" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Remove the Shortcut Arrow Icon" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglRemoveShortcutArrow" Tag="RemoveShortcutArrow" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- RESTORE MISSING UI ELEMENTS FOR C# -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Advanced Utilities" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <TextBlock x:Name="TxtMsiStatus" Text="MSI Interrupt Mode Status" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnMsiScan" Content="Scan MSI Mode" Style="{StaticResource OutlineButton}" Click="BtnMsiScan_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnMsiEnable" Content="Enable MSI Mode" Style="{StaticResource OutlineButton}" Click="BtnMsiEnable_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnMsiRevert" Content="Revert MSI Mode" Style="{StaticResource OutlineButton}" Click="BtnMsiRevert_Click"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtDebloatLoading" Text="AppX Loading Status" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10"/>
                                        
                                        <StackPanel x:Name="PnlServiceToggles" Margin="0,0,0,10">
                                            <!-- Dummy Service Toggles (They are populated in code if missing) -->
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnScanAppx" Content="Scan AppX" Style="{StaticResource OutlineButton}" Click="BtnScanAppx_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnRemoveAppx" Content="Remove AppX" Style="{StaticResource OutlineButton}" Click="BtnRemoveAppx_Click"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtNoAppx" Text="No packages found." Foreground="LightGreen" Margin="0,0,0,10" Visibility="Collapsed"/>
                                        
                                        <ItemsControl x:Name="IcAppxPackages" Margin="0,0,0,10">
                                            <!-- Dynamically populated AppX packages -->
                                        </ItemsControl>

                                        <TextBlock Text="Network Stack Optimizer" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,10"/>
                                        <TextBlock x:Name="TxtNetAutoTune" Text="AutoTune: Unknown" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="TxtNetEcn" Text="ECN: Unknown" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="TxtNetTimestamps" Text="Timestamps: Unknown" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock x:Name="TxtNetRss" Text="RSS: Unknown" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10"/>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnNetApply" Content="&#x26A1; Apply Optimizations" Style="{StaticResource OutlineButton}" Click="BtnNetApply_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnNetRevert" Content="Revert Net Opt" Style="{StaticResource OutlineButton}" Click="BtnNetRevert_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnNetRefresh" Style="{StaticResource OutlineButton}" Click="BtnNetRefresh_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- TAB 7: OS TOOLS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Windows Resources" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Quick access to powerful built-in Windows management utilities." Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <!-- Content Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="Disk Management" Tag="diskmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Computer Management" Tag="compmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="1" Grid.Column="0" Content="Task Manager" Tag="taskmgr" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Programs and Features" Tag="appwiz.cpl" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="2" Grid.Column="0" Content="Device Manager" Tag="devmgmt.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Event Viewer" Tag="eventvwr.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            
                            <Button Grid.Row="3" Grid.Column="0" Content="System Properties" Tag="sysdm.cpl" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="Control Panel" Tag="control" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>

                            <Button Grid.Row="4" Grid.Column="0" Content="Registry Editor" Tag="regedit.exe" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="Group Policy Editor" Tag="gpedit.msc" Style="{StaticResource OutlineButton}" Margin="10" Height="60" Click="BtnOsTool_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 8: STORAGE TOOLS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Storage Tools" Foreground="White" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Move game directories to secondary drives using NTFS symbolic links â€” launchers never know the files moved." 
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Migrator Card -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="NTFS Symlink Game Migrator" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Select a source game directory and a destination on another drive. The engine will move the files, verify integrity, then create a transparent symbolic link at the original path." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                        <!-- Source Path -->
                                        <TextBlock Text="Source Directory" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#12122A" BorderBrush="#333350" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtMigSource" Foreground="White" FontSize="13" Text="No directory selected..."/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource OutlineButton}" Padding="14,8" Click="BtnMigBrowseSource_Click"/>
                                        </Grid>

                                        <!-- Destination Path -->
                                        <TextBlock Text="Destination Directory (on target drive)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#12122A" BorderBrush="#333350" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtMigDest" Foreground="White" FontSize="13" Text="No destination selected..."/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource OutlineButton}" Padding="14,8" Click="BtnMigBrowseDest_Click"/>
                                        </Grid>

                                        <!-- Analysis Row -->
                                        <TextBlock x:Name="TxtMigAnalysis" Foreground="#3B82F6" FontSize="13" Margin="0,0,0,12" Visibility="Collapsed"/>

                                        <!-- Progress -->
                                        <ProgressBar x:Name="ProgMigrate" Height="6" Margin="0,0,0,8"
                                                     Foreground="#6366F1" Background="#1E1E3A" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMigProgress" Foreground="{StaticResource BrushTextMuted}" FontSize="12" 
                                                   Margin="0,0,0,12" Visibility="Collapsed"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnMigAnalyze" Content="&#xE8B0; Analyze" Style="{StaticResource OutlineButton}"
                                                    Padding="14,8" Margin="0,0,10,0" IsEnabled="False" Click="BtnMigAnalyze_Click"/>
                                            <Button x:Name="BtnMigrate" Content="&#xE8DE; Migrate &amp; Symlink" Style="{StaticResource PremiumButton}"
                                                    Padding="14,8" IsEnabled="False" Click="BtnMigrate_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- History Card -->
                                <Border Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Previous Migrations" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <Button Grid.Column="1" Content="&#xE72C; Refresh" Style="{StaticResource OutlineButton}"
                                                    Padding="10,4" FontSize="12" Click="BtnMigRefreshHistory_Click"/>
                                        </Grid>

                                        <ItemsControl x:Name="IcMigrationHistory">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0D0D1F" CornerRadius="6" Padding="12,10" Margin="0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding OriginalPath}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11">
                                                                    <Run Text="Ã¢â€ â€™ "/>
                                                                    <Run Text="{Binding DestinationPath}"/>
                                                                    <Run Text="  Ã¢â‚¬Â¢  "/>
                                                                    <Run Text="{Binding SizeBytes, Converter={x:Static local:BytesConverter.Instance}}"/>
                                                                    <Run Text="  Ã¢â‚¬Â¢  "/>
                                                                    <Run Text="{Binding MigratedAt, StringFormat='{}{0:MMM dd, yyyy}'}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                                    Background="{Binding SymlinkActive, Converter={x:Static local:BoolToBadgeConverter.Instance}}">
                                                                <TextBlock Foreground="White" FontSize="10" FontWeight="Bold"
                                                                           Text="{Binding SymlinkActive, Converter={x:Static local:BoolToSymlinkLabelConverter.Instance}}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="TxtNoHistory" Text="No migrations recorded yet." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="13" 
                                                   HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>






