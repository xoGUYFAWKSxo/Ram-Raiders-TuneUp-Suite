                                            <CheckBox Grid.Column="1" x:Name="TglDisablePreventShutdown" Tag="DisablePreventShutdown" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CATEGORY 3: Security and Stability Tweaks -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <TextBlock Text="Security &amp; Stability Tweaks" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Apply All in this Category" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="BtnApplyCategory_Click" Tag="SecurityStability"/>
                                        </Grid>
                                        <Separator Background="#33FFFFFF" Margin="0,0,0,15"/>
                                        
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Close unresponsive processes to avoid system crashes" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglCloseUnresponsive" Tag="CloseUnresponsive" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Disable security warning for downloaded files" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglDisableSecurityWarning" Tag="DisableSecurityWarning" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Add 'Take Ownership' option to File Explorer" Foreground="White" FontWeight="SemiBold" FontSize="14"/></StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="TglTakeOwnership" Tag="TakeOwnership" Style="{StaticResource PremiumToggle}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
