<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette System -->
    <Color x:Key="ColorBgDeep">#0D0D11</Color>
    <Color x:Key="ColorBgDark">#13131A</Color>
    <Color x:Key="ColorBgCard">#1A1A24</Color>
    <Color x:Key="ColorTextMain">#F5F5FA</Color>
    <Color x:Key="ColorTextMuted">#8E8E9E</Color>
    
    <!-- Neon Accent Gradients -->
    <Color x:Key="ColorAccentCyan">#00F0FF</Color>
    <Color x:Key="ColorAccentIndigo">#6200EE</Color>
    <Color x:Key="ColorAccentPurple">#B388FF</Color>
    <Color x:Key="ColorAccentGreen">#00FF87</Color>
    
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}"/>
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushTextMain" Color="{StaticResource ColorTextMain}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}"/>
    <SolidColorBrush x:Key="BrushAccentIndigo" Color="{StaticResource ColorAccentIndigo}"/>
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}"/>
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorAccentGreen}"/>
    
    <LinearGradientBrush x:Key="BrushNeonAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorAccentIndigo}" Offset="0"/>
        <GradientStop Color="{StaticResource ColorAccentCyan}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGreenAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00BA63" Offset="0"/>
        <GradientStop Color="{StaticResource ColorAccentGreen}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Custom Glassmorphism Card Style -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="#1A1A26"/>
        <Setter Property="BorderBrush" Value="#2A2A38"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.4"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium Rounded Button Template -->
    <Style x:Key="PremiumButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushNeonAccent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#7F39FB"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource ColorAccentCyan}" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#5200CC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#2D2D3A"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium Outline Button -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
        <Setter Property="BorderBrush" Value="#3D3D4E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            <Setter TargetName="border" Property="Background" Value="#1E1E2C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#252538"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Animated Toggle Switch -->
    <Style x:Key="PremiumToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid x:Name="grid" Width="44" Height="22" Margin="0,0,10,0">
                            <Border x:Name="BackgroundBorder" 
                                    Background="#2E2E3A" 
                                    CornerRadius="11" 
                                    BorderThickness="1" 
                                    BorderBrush="#3E3E4D"/>
                            <Ellipse x:Name="Thumb" 
                                     Fill="#8E8E9E" 
                                     Width="16" 
                                     Height="16" 
                                     HorizontalAlignment="Left" 
                                     Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource BrushNeonAccent}"/>
                            <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                         To="20" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium Glowing ProgressBar Template -->
    <Style x:Key="PremiumProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="#1A1A24"/>
        <Setter Property="Foreground" Value="{StaticResource BrushNeonAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}"/>
                        <Grid x:Name="PART_Indicator" ClipToBounds="True" HorizontalAlignment="Left">
                            <Border x:Name="Indicator" 
                                    Background="{TemplateBinding Foreground}" 
                                    CornerRadius="4"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Sidebar Navigation Item -->
    <Style x:Key="SidebarButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="GroupName" Value="SidebarGroup"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E1E2C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#252538"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushNeonAccent}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
